{
  "name": "@hermes/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Hermes Mobile \u2014 the Android companion app for a Hermes Agent gateway/dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "fix": "npm run lint:fix",
    "check": "npm run typecheck && npm run test && npm run lint",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
